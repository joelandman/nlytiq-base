# Source tarballs are fetched from upstream on demand and verified against
# sources/manifest.txt, rather than being stored here. See config/fetch.config.
/sources/*.tar.gz
/sources/*.tar.xz
/sources/*.tar.bz2
/sources/*.tar.zst
/sources/*.tar.zstd
/sources/*.tgz
/sources/*.zip

# ...except these two, which are local 'git clone' snapshots rather than
# upstream release artifacts, so no URL reproduces them. Both are tiny.
!/sources/spark-0.46.tar.gz
!/sources/maxima-kernel.tar.gz

# Extracted / built source trees. The Makefiles unpack tarballs from sources/
# into the top level and build in place; none of that belongs in the repo.
/julia/
/julia-*/
/Python-*/
/OpenBLAS-*/
/llvm-project-*/
/llvm-*/
/gnuplot-*/
/octave-*/
/maxima-*/
/perl-*/
/R-*/
/spark-*/
/rustc-*/
/node-*/
/go/

# Build stamp files. Each Makefile.<pkg> touches an empty file to record that a
# step is done -- configure-octave, make-perl, install-python and so on -- and
# the top-level Makefile does the same with <pkg>.build, <pkg>.complete and
# <pkg>.packages. They accumulate at the top level as the tree is built, and
# 'make clean' removes them. Anchored to the root, where they are created, so
# these patterns cannot swallow anything under config/ or sources/.
/configure-*
/make-*
/build-*
/install-*
/*.build
/*.complete
/*.packages

# Stray build output
/out
*.o
*.a
*.so
*.so.*
*.pyc
__pycache__/

# Editor cruft
*.swp
*~
*-e
