*.gz filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.bz2 filter=lfs diff=lfs merge=lfs -text
*.xz filter=lfs diff=lfs merge=lfs -text
*.zst filter=lfs diff=lfs merge=lfs -text
*.zstd filter=lfs diff=lfs merge=lfs -text
*.lz filter=lfs diff=lfs merge=lfs -text
*.lzma filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# Source tarballs are no longer stored in this repository, so the rules above
# are a safety net: anything large that does get committed lands in LFS rather
# than bloating the git history. These two are the deliberate exceptions --
# local clone snapshots of a few tens of KB, kept as ordinary git objects so a
# plain clone needs no git-lfs at all.
sources/spark-0.46.tar.gz -filter -diff -merge -text
sources/maxima-kernel.tar.gz -filter -diff -merge -text
